# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT & Session Security
JWT_SECRET=replace_with_a_secure_random_jwt_secret_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_string

# Allowed Frontend Origins (Comma-separated for multiple origins)
FRONTEND_URL=http://localhost:5173,https://chandan-tiwadi.pages.dev

# Cloudinary Media Management
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Default Administrator Credentials (used for initial creation via createAdmin.js)
ADMIN_EMAIL=chandan110906@gmail.com
ADMIN_PASSWORD=your_secure_admin_password

